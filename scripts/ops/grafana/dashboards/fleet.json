    {
      "type": "table",
      "title": "Workers",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "ucloud-metrics"
      },
      "description": "Click a cell for actions. Drain: no new work, parks move away, stopped once empty. Drain and evict: also deletes its sandboxes. Undrain: back into service.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_active_sandboxes)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_resources{kind=\"used\",resource=\"vcpu\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_resources{kind=\"total\",resource=\"vcpu\"})",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_resources{kind=\"free\",resource=\"memory_mb\"})",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_resources{kind=\"free\",resource=\"disk_mb\"})",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_cpu_percent)",
          "legendFormat": "",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_memory_psi_full_avg10)",
          "legendFormat": "",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_heartbeat_age_seconds)",
          "legendFormat": "",
          "refId": "H",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_operator_drained)",
          "legendFormat": "",
          "refId": "I",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ucloud-metrics"
          },
          "expr": "max by (job_id, role) (ucloud_fleet_node_soft_drained)",
          "legendFormat": "",
          "refId": "J",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "job_id": "job_id",
              "role": "Role",
              "Value #A": "Sandboxes",
              "Value #B": "vCPU used",
              "Value #C": "vCPU",
              "Value #D": "Memory free (MB)",
              "Value #E": "Disk free (MB)",
              "Value #F": "CPU %",
              "Value #G": "Memory PSI",
              "Value #H": "Heartbeat age (s)",
              "Value #I": "Operator drained",
              "Value #J": "Soft drained"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Sandboxes",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "actions": [
            {
              "type": "fetch",
              "title": "Drain",
              "confirmation": "Drain worker ${__data.fields[\"job_id\"]}? It takes no new work and is stopped once empty.",
              "fetch": {
                "method": "POST",
                "url": "/grafana/ops/v1/nodes/${__data.fields[\"job_id\"]}/drain",
                "headers": [
                  [
                    "X-UCloud-Ops",
                    "1"
                  ],
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": [],
                "body": "{}"
              }
            },
            {
              "type": "fetch",
              "title": "Drain and evict",
              "confirmation": "Drain worker ${__data.fields[\"job_id\"]} and DELETE every sandbox on it?",
              "fetch": {
                "method": "POST",
                "url": "/grafana/ops/v1/nodes/${__data.fields[\"job_id\"]}/drain",
                "headers": [
                  [
                    "X-UCloud-Ops",
                    "1"
                  ],
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": [],
                "body": "{\"evict\": true}"
              }
            },
            {
              "type": "fetch",
              "title": "Undrain",
              "confirmation": "Put worker ${__data.fields[\"job_id\"]} back into service?",
              "fetch": {
                "method": "POST",
                "url": "/grafana/ops/v1/nodes/${__data.fields[\"job_id\"]}/undrain",
                "headers": [
                  [
                    "X-UCloud-Ops",
                    "1"
                  ],
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
